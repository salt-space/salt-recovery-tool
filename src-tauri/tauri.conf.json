{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Salt Recovery Tool",
  "version": "0.2.3",
  "identifier": "com.salt.recovery-tool",
  "build": {
    "beforeDevCommand": "npm run hmr",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../build/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Salt Recovery Tool",
        "width": 1100,
        "height": 820,
        "minWidth": 880,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/sl-dkls23-LICENSE.txt": "licenses/sl-dkls23-LICENSE.txt",
      "../licenses/sl-mpc-mate-LICENSE.txt": "licenses/sl-mpc-mate-LICENSE.txt"
    }
  }
}
